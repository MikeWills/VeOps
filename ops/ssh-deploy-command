#!/usr/bin/env bash
# /opt/vesessionmanager/ops/ssh-deploy-command — forced command for THIS app's deploy key.
#
# Installed by ops/setup-server.sh into /home/deploy/.ssh/authorized_keys as:
#
#   command="/opt/vesessionmanager/ops/ssh-deploy-command",no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty ssh-ed25519 AAAA... vesessionmanager-ci
#
# The key can do exactly three things: receive an rsync into this app's releases/ directory, run
# deploy-release <tag>, and prune old releases. Anything else is refused. The shared `deploy` login
# used to carry an unrestricted key, so a leaked repo secret was a shell on the box with every
# sibling app's sudoers grant attached; now a leak of THIS secret can, at worst, upload a build
# into a fresh releases/<tag>/ directory and ask for it to be deployed — which the health check and
# automatic rollback in deploy-release then judge like any other release.
set -euo pipefail

APP="vesessionmanager"
BASE="/opt/$APP"
KEEP=5
cmd="${SSH_ORIGINAL_COMMAND:-}"

case "$cmd" in
  # What `rsync -avz --delete -e ssh publish/<host>/ deploy@box:/opt/<app>/releases/<tag>/<host>/`
  # asks the far end to run: "rsync --server -vlogDtprze.iLsfxCIvu --delete . <dest>". The
  # destination is the last word, and it must be a tag-shaped directory under releases/ — never
  # current/, never ops/, never anything with a shell metacharacter in it.
  "rsync --server "*" $BASE/releases/"*)
    dest="${cmd##* }"
    [[ "$dest" =~ ^$BASE/releases/2[0-9]{3}\.[0-9]{2}\.[0-9]+/(web|worker)/$ ]] || { echo "refused dest: $dest" >&2; exit 2; }
    [[ "$cmd" != *";"* && "$cmd" != *"&"* && "$cmd" != *"|"* && "$cmd" != *'`'* && "$cmd" != *'$'* && "$cmd" != *".."* ]] || { echo "refused" >&2; exit 2; }
    mkdir -p "$dest"
    # shellcheck disable=SC2086 -- the whole point is to run rsync's own server command line
    exec $cmd
    ;;
  "deploy "*)
    tag="${cmd#deploy }"
    exec "$BASE/ops/deploy-release" "$tag"
    ;;
  "prune")
    # Newest $KEEP by version, and never the one `current` points at, whatever its age. Sorted by
    # name rather than mtime: an rsync re-run against an old tag would otherwise make it look new.
    cd "$BASE/releases"
    current="$(basename "$(readlink -f "$BASE/current")")"
    ls -1d 2*/ 2>/dev/null | sed 's|/$||' | sort -V -r | grep -vx "$current" | tail -n +"$KEEP" | xargs -r rm -rf --
    echo "kept: $(ls -1d 2*/ | sed 's|/$||' | sort -V | tr '\n' ' ')"
    ;;
  *)
    echo "refused: '$cmd'" >&2
    exit 2
    ;;
esac
