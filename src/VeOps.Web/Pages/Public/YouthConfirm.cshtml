@page "/youth-confirm/{token:guid}"
@model VeOps.Web.Pages.Public.YouthConfirmModel
@using VeOps.Core.Payments
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@{
    ViewData["Title"] = "Youth Rate Confirmation";
    Layout = "_PublicLayout";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1>Youth Rate Confirmation</h1>

        @if (Model.Outcome == YouthConfirmationOutcome.Success)
        {
            <partial name="_YouthConfirmForm" model="Model.Input"
                     view-data="@(new ViewDataDictionary(ViewData) { ["IntroHtml"] = Model.IntroHtml })" />
        }
        else if (Model.Outcome == YouthConfirmationOutcome.AlreadyResolved)
        {
            <p class="policy-note">This payment has already been resolved — there's nothing left to confirm here. If that doesn't seem right, contact your Volunteer Examiner team.</p>
        }
        else if (Model.Outcome == YouthConfirmationOutcome.FeeNotConfigured || Model.Outcome == YouthConfirmationOutcome.SquareNotConfigured)
        {
            <p class="policy-note">The youth rate isn't fully set up yet for this session. Please contact your Volunteer Examiner team directly instead of using this link.</p>
        }
        else
        {
            <p class="policy-note">This link isn't valid. Please contact your Volunteer Examiner team if you believe this is an error.</p>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
