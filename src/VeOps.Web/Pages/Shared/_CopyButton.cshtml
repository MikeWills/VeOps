@model VeOps.Web.CopyButton
@*
    A quiet copy button, for a value the reader is going to paste somewhere else — an FRN into the
    FCC's search, most often from a phone, where selecting text by hand is genuinely awkward.

    .icon-action rather than a labelled button: these sit inline beside the value they copy, and a
    full button around the word "Copy" takes several times the width of the figure itself.

    The value travels in a data attribute rather than an inline handler because the CSP is
    `script-src 'self'`, which drops inline handlers silently. app.js binds it.
*@
@if (!string.IsNullOrWhiteSpace(Model.Value))
{
    <button type="button" class="icon-action" data-copy-value="@Model.Value"
            title="Copy @Model.What @Model.Value" aria-label="Copy @Model.What @Model.Value">
        <i class="bi bi-clipboard" aria-hidden="true"></i>
    </button>
}
