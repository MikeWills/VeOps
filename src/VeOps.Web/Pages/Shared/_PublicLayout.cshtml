@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VE Ops</title>
    @* Mirrors _AppLayout — render-blocking, before first paint. No server-rendered data-theme here:
       these pages have no signed-in user, so theme.js falls through to localStorage (this browser's
       last choice, including one made while signed in) and then the OS setting. *@
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @* Self-hosted fonts and icons: the CSP allows font-src 'self' only, so a Google Fonts or CDN
       reference would be blocked. Loaded before app.css so the design system can override them. *@
    <link rel="icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="icon" href="~/img/veops-icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" />
    <link rel="manifest" href="~/site.webmanifest" />
    <link rel="stylesheet" href="~/lib/fonts/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="vesm">
    <header class="chassis">
        <span class="brand"><img class="mark" src="~/img/veops-icon.svg" alt="" width="22" height="22" />VE Ops</span>
        <div style="flex:1"></div>
        <button id="themeToggle" class="theme-toggle" type="button"></button>
    </header>
    <partial name="_TestModeBanner" />
    <partial name="_SystemBanner" />

    @* 760px suits a form or a policy; the documentation, with its sidebar, asks for the full
       width and says so through ViewData. *@
    <main class="vesm-main" style="max-width:@(ViewData["MainMaxWidth"] ?? "760px");">
        @* Must mirror _AppLayout's block. Every page on this layout sets TempData["StatusMessage"]
           and ["ErrorMessage"] and none of them rendered until 2026-08-11 (issue #241) — so all
           thirteen outcomes of VE self-service, including "that address is already in use" and
           "we couldn't send the mail", redirected to a byte-identical page. A VE editing their own
           record was told nothing either way, on the app's only unauthenticated PII-editing
           surface. The switch statements setting them were dead code. *@
        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="vesm-alert success">@statusMessage</div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="vesm-alert error">@errorMessage</div>
        }
        @RenderBody()
    </main>

    <footer class="vesm-footer" style="max-width:760px;">
        <span>VE Ops @VeOps.Core.AppVersion.Display</span>
        <a asp-page="/Privacy">Privacy</a>
        <a href="https://github.com/MikeWills/VeOps" target="_blank" rel="noopener noreferrer">Source</a>
    </footer>

    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
