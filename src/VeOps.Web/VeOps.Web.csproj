<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\VeOps.Core\VeOps.Core.csproj" />
  </ItemGroup>

  <!-- Same pattern as VeOps.Core's own InternalsVisibleTo — lets a page's internal-static
       calculation logic (e.g. TransactionsReportModel.BuildRows) be tested directly, without a
       database or a signed-in user, instead of only through the full page-rendering smoke test. -->
  <ItemGroup>
    <InternalsVisibleTo Include="VeOps.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.10" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Deliberately the same id as VeOps.Worker's: Phase 3's Square secrets (e.g.
         WebhookSignatureKey) are needed by both projects, and sharing one secrets.json means
         `dotnet user-secrets set` only needs to be run once, against either project. -->
    <UserSecretsId>dotnet-VeOps.Worker-7144504e-98be-4ccd-ab50-694b48bd088d</UserSecretsId>
  </PropertyGroup>


  <!-- Shared config, linked rather than copied: the same physical files are used by both hosts, so
       Square/ExamTools cannot drift between them again (see src/Shared/appsettings.Shared.json). -->
  <ItemGroup>
    <Content Include="../Shared/appsettings.Shared*.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The user manual (docs/wiki) ships inside the app and is rendered at /Help by HelpPages.
       Copied into the build output as content so there is still exactly one master copy — the
       same files the GitHub wiki is built from. images/README.md is authoring guidance, not a page. -->
  <ItemGroup>
    <Content Include="../../docs/wiki/**/*" Exclude="../../docs/wiki/images/README.md"
             LinkBase="Help" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
